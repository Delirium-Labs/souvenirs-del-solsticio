# La llave publicable de Supabase es pública por diseño; RLS protege la escritura.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Reservada para un futuro proxy del servidor. La app actual no lee esta variable:
# para la prueba local, pega la llave en el formulario «✦ IA».
# No uses VITE_OPENAI_API_KEY: Vite la incluiría en el JavaScript público.
OPENAI_API_KEY=
